{
  "name": "daybook",
  "productName": "Daybook",
  "version": "1.4.0",
  "description": "Daybook — a small, calm desktop tracker: focus, movement and tasks in four tabs.",
  "author": {
    "name": "Daybook Press",
    "email": "press@daybook.local"
  },
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "assets": "node scripts/make-icons.mjs && node scripts/copy-fonts.mjs && node scripts/optimise-images.mjs",
    "predev": "npm run assets",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run assets",
    "build": "rimraf dist dist-electron && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/test.mjs",
    "inspect": "node scripts/inspect.mjs",
    "verify": "node scripts/verify.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:all": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.2.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "framer-motion": "^11.11.9",
    "geist": "^1.3.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
